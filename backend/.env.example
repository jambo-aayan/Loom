# Secrets live in env/config only, never in the DB or hardcoded (ADR-0004).
# Copy to .env and fill in for a real deployment; every value below has a safe local-dev
# fallback (sqlite + fake broker/market-data/LLM) baked into loom/settings.py and loom/api/deps.py,
# so the API and CLI both run with none of this set.

DATABASE_URL=postgresql+psycopg://user:password@ep-example.eu-west-2.aws.neon.tech/loom

# T212 uses HTTP Basic Auth: API key as username, API secret as password. A T212 account issues
# exactly ONE key+secret pair total — not one per demo/live — and it authenticates identically
# against either base URL below; only the URL decides which environment a request hits. Both key
# AND secret are required for Loom to use the real client; if either is blank, every environment
# falls back to the in-process fake broker. The "Live trading gate" in Settings, not a separate
# credential, is what actually stands between this key and a real order.
T212_API_KEY=
T212_API_SECRET=
T212_DEMO_BASE_URL=https://demo.trading212.com/api/v0
T212_LIVE_BASE_URL=https://live.trading212.com/api/v0

TWELVE_DATA_API_KEY=
ANTHROPIC_API_KEY=

# M5: the research-tier Insight's free-automatic path (ticket #48, ADR-0013). Only ever runs for
# investment-style strategies' pending_approval/auto_approved signals. Leave blank in dev to use
# the FakeInsightGenerator; never falls back to a paid provider automatically. The paid tier
# (Claude Sonnet, via ANTHROPIC_API_KEY above) is exclusively user-triggered from the dashboard —
# no automatic caller anywhere reaches it, regardless of this setting.
GOOGLE_API_KEY=

# M3: Web Push (ticket #39). Generate a VAPID key pair with:
#   python scripts/generate_vapid_keys.py
# Leave both blank in dev — /push/vapid-public-key returns null and the frontend skips
# subscribing, falling back to in-app Approvals/email only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# M3: Email (ticket #41). Leave SMTP_HOST blank in dev to use the FakeEmailSender (recorded
# in-memory, nothing actually sent).
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=loom@example.com
NOTIFY_EMAIL=you@example.com
